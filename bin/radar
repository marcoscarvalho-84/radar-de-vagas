#!/bin/bash
# Ponto de entrada único do Radar de Vagas: bin/radar <comando> (bin/radar --help).
#
# Acha o Python certo, nesta ordem: $RADAR_PYTHON, a venv do bin/instalar em
# ~/.cache/radar-de-vagas/venv, uma .venv na raiz, e por fim o python3 do sistema.
# A venv fica FORA da pasta do projeto de propósito: Dropbox, iCloud e Drive tiram
# arquivos do disco ("dataless") e o Python trava ao abrir uma venv sincronizada.
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -n "${RADAR_PYTHON:-}" ]; then
  PY="$RADAR_PYTHON"
elif [ -x "$HOME/.cache/radar-de-vagas/venv/bin/python" ]; then
  PY="$HOME/.cache/radar-de-vagas/venv/bin/python"
elif [ -x "$RAIZ/.venv/bin/python" ]; then
  PY="$RAIZ/.venv/bin/python"
else
  PY="$(command -v python3)"
fi

# macOS com Homebrew: o WeasyPrint abre glib, pango, harfbuzz e fontconfig pelo nome.
# Linkadas, elas estão em <brew>/lib. O <brew>/opt/<pacote>/lib cobre a instalada mas
# desligada do lib/ (a glib depois de um upgrade, por exemplo), que fazia o
# `bin/radar cv` falhar com libgobject até alguém rodar `brew link glib`.
if [ "$(uname)" = "Darwin" ]; then
  LIBS=""
  for P in /opt/homebrew /usr/local; do
    for LIB in "$P/lib" "$P"/opt/{glib,pango,harfbuzz,fontconfig}/lib; do
      if [ -d "$LIB" ]; then LIBS="${LIBS:+$LIBS:}$LIB"; fi
    done
  done
  if [ -n "$LIBS" ]; then
    export DYLD_FALLBACK_LIBRARY_PATH="$LIBS${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
  fi
fi

export PYTHONPATH="$RAIZ${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m radar "$@"
